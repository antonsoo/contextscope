{
  "name": "contextscope",
  "version": "0.1.0",
  "description": "See what's actually in your LLM context window, and why your prompt cache keeps missing.",
  "type": "module",
  "author": "Anton Soloviev",
  "license": "MIT",
  "homepage": "https://antonsoo.github.io/contextscope/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antonsoo/contextscope.git"
  },
  "bugs": {
    "url": "https://github.com/antonsoo/contextscope/issues"
  },
  "keywords": [
    "llm",
    "anthropic",
    "claude",
    "openai",
    "prompt-caching",
    "tokenizer",
    "developer-tools",
    "cli"
  ],
  "bin": {
    "contextscope": "./dist/cli/index.js"
  },
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    }
  },
  "files": [
    "dist",
    "examples"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "npm run build:core && npm run build:cli",
    "build:core": "tsc -p tsconfig.json",
    "build:cli": "tsc -p tsconfig.json",
    "build:web": "vite build web",
    "build": "npm run build:core && npm run build:web",
    "dev:web": "vite web",
    "preview:web": "vite preview web",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "cli": "node --experimental-strip-types src/cli/index.ts"
  },
  "dependencies": {
    "gpt-tokenizer": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "js-tiktoken": "^1.0.21",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
